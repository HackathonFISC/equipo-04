# Plantilla de variables de entorno. Copiar a `.env` (ignorado por git) y completar SOLO lo que se vaya a activar.
# NUNCA escribir claves reales en este archivo. Sin claves, el sistema funciona en modo simulado.
# Guía de cada proveedor: docs/API_SETUP.md · Estado: `uv run water-coordinator estado`

APP_ENV=development
LOG_LEVEL=INFO

# --- Modelo de IA (AutoGen). none | openai | openai_compatible | anthropic ---
# none = solo reglas deterministas. openai_compatible sirve para Ollama local (gratis), vLLM, etc.
MODEL_PROVIDER=none
MODEL_NAME=
MODEL_API_KEY=
# Ejemplo Ollama: http://localhost:11434/v1
MODEL_BASE_URL=

# --- Geocodificación. none | nominatim ---
GEOCODER_PROVIDER=none
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Obligatorio por la política de uso: identifica la app y un contacto. Ej.: water-coordinator/0.2 (equipo04@ejemplo.invalid)
NOMINATIM_USER_AGENT=
NOMINATIM_EMAIL=

# --- Rutas (OSRM). Vacío = no configurado. El servidor público de demo no garantiza disponibilidad. ---
OSRM_BASE_URL=
OSRM_PROFILE=driving
# Ubicación de la organización [PEND en el documento de criterios]
ORGANIZACION_LAT=
ORGANIZACION_LON=

# --- Mapas (Leaflet en el frontend, teselas OSM con atribución) ---
MAP_TILE_URL=
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Mensajería. mock | whatsapp_cloud ---
MESSAGING_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Debe seguir en false hasta tener aprobación explícita para enviar mensajes reales.
WHATSAPP_SEND_ENABLED=false

# --- Transcripción. none | whisper_local | google ---
TRANSCRIPTION_PROVIDER=none
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Ruta al JSON de la cuenta de servicio de Google (fuera del repositorio)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_STT_LANGUAGE=es-US

# --- Base de datos (SQLAlchemy). PostgreSQL: postgresql+psycopg://usuario:clave@host/bd (requiere instalar psycopg) ---
DATABASE_URL=sqlite:///./storage/water.db

# --- Archivos locales ---
STORAGE_DIR=./storage/media
STORAGE_MAX_FILE_MB=25
STORAGE_ALLOWED_EXTENSIONS=.txt,.json,.ogg,.opus,.mp3,.m4a,.wav,.mp4
# Vacío = sin borrado automático (política de retención [PEND])
STORAGE_RETENTION_DAYS=

# --- Monitoreo externo opcional (no implementado; logs JSON locales siempre activos) ---
SENTRY_DSN=

# --- Parámetros operativos ---
# JSON que reemplaza los horarios por defecto (ver services/parametros.py). Vacío = horarios aprobados.
HORARIOS_FILE=
# Personas con las que A llega a 100 (DEC-C05)
A_PERSONAS_REFERENCIA=1000
