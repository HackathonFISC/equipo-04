{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "http.server", "5500", "--bind", "127.0.0.1", "-d", "frontend"],
      "port": 5500
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "water_coordinator.api.app:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
